{%- set T = t[lang] -%}
{#- lang is the language of the page's own words (the chrome); contentLang, when set, is the
    language of the text it shows (a post not yet translated shows the other language). -#}
{%- set htmlLang = contentLang or lang -%}
{%- set alt = page.url | altUrls(pairKey) -%}
<!doctype html>
<html lang="{{ htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if title and page.url != T.root %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}.xyz · {{ site.author }}{% endif %}</title>
  <meta name="description" content="{{ description or site.about[lang] }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- if alt.en != alt.es %}
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ alt.en }}">
  <link rel="alternate" hreflang="es" href="{{ site.url }}{{ alt.es }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alt.en }}">
  {%- endif %}
  <link rel="icon" type="image/png" href="/img/calabaza.png">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}, English" href="/feed.xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}, Español" href="/es/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap">
  <header class="top"{% if lang != htmlLang %} lang="{{ lang }}"{% endif %}>
    <a class="mark" href="{{ T.root }}"><img src="/img/calabaza.png" width="356" height="336" alt="{{ T.mascot }}"><span>{{ site.name }}<span class="xyz">.xyz</span></span></a>
    <nav class="main" aria-label="{{ T.nav }}">
      <a href="{{ T.root }}#posts">{{ T.writing }}</a>
      <a href="{{ T.root }}#lab">{{ T.about }}</a>
      <a href="{{ T.root }}#elsewhere">{{ T.elsewhere }}</a>
      <a href="{{ T.feed }}">{{ T.rss }}</a>
      <span class="langs" role="group" aria-label="{{ T.language }}">
        {%- for l in ["en", "es"] %}
        {%- if loop.index0 %}<span aria-hidden="true">·</span>{% endif %}
        <a href="{{ alt[l] }}" hreflang="{{ l }}" lang="{{ l }}"{% if l == lang %} aria-current="page"{% endif %}>{{ t.langs[l].short }}</a>
        {%- endfor %}
      </span>
    </nav>
  </header>

{{ content | safe }}

  <footer class="bottom"{% if lang != htmlLang %} lang="{{ lang }}"{% endif %}>
    <span>Eleventy · hosted on Caravana · <a href="{{ site.repo }}">{{ T.source | lower }}</a></span>
    <nav aria-label="{{ T.legal }}"><a href="/privacy/">{{ T.privacy }}</a><a href="/terms/">{{ T.terms }}</a></nav>
    <span>{{ site.name }}.xyz · {{ site.author }} · 2013–{{ site.year }}</span>
  </footer>
</div>
</body>
</html>
