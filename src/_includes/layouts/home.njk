---
layout: layouts/base.njk
---
{%- set T = t[lang] %}
{%- set listPairs = collections.postPairs %}
  <div class="cols">

    <aside class="col lab" id="lab" aria-label="{{ T.lab }}">
      <section class="sec about">
        <div class="label"><span>{{ T.about }}</span></div>
        <p>{{ site.about[lang] }}</p>
      </section>

      <section class="sec now">
        <div class="label"><span>{{ T.now }}</span></div>
        <p>{{ site.now.text[lang] }}</p>
        <time datetime="{{ site.now.updated }}">{{ T.updated }} {{ site.now.updated }}</time>
      </section>

      <section class="sec">
        <div class="label"><span>{{ T.make }}</span></div>
        <ul class="make-list">
          {%- for item in site.make %}
          <li>{% if item.url %}<a href="{{ item.url }}">{{ item.name }}</a>{% else %}<strong class="name">{{ item.name }}</strong>{% endif %}<span>{{ item.what }}</span></li>
          {%- endfor %}
        </ul>
      </section>
    </aside>

    <main class="col posts" id="posts">
      <section class="sec intro">
        <h1>{{ T.headline | safe }}</h1>
        <p>{{ T.tagline }}</p>
      </section>

      <section class="sec">
        <div class="label"><span>{{ T.writing }}</span></div>
        {% include "partials/post-list.njk" %}
        <div class="posts-foot"><a href="{{ T.root }}posts/">{{ T.allPostsLink }}</a></div>
      </section>
    </main>

    <aside class="col elsewhere" id="elsewhere" aria-label="{{ T.elsewhereAria }}">
      <section class="sec">
        <div class="label"><span>{{ T.elsewhere }}</span></div>
        <ul class="out-list">
          {%- if site.hollo %}
          <li><span class="k"><a href="{{ site.hollo }}" rel="me">Hollo</a></span><span class="h">@{{ site.author }}</span></li>
          {%- endif %}
          {%- if site.github %}
          <li><span class="k"><a href="{{ site.github }}" rel="me">GitHub</a></span><span class="h">jjchiw</span></li>
          {%- endif %}
          {%- if site.x %}
          <li><span class="k"><a href="{{ site.x }}" rel="me">X</a></span><span class="h">@{{ site.author }}</span></li>
          {%- endif %}
          <li><span class="k">Email</span><span class="h"><a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></span></li>
        </ul>
      </section>

      {%- if hollo and hollo.length %}
      <section class="sec">
        <div class="label"><span>{{ T.latestHollo }}</span><a href="{{ site.hollo }}">{{ T.more }}</a></div>
        {%- for toot in hollo %}
        <div class="toot">
          {{ toot.content | safe }}
          <div class="meta"><a href="{{ site.hollo }}">@{{ site.author }}</a><a href="{{ toot.url }}"><time datetime="{{ toot.published }}">{{ toot.published | dateFormat(lang) }}</time></a></div>
        </div>
        {%- endfor %}
      </section>
      {%- endif %}
    </aside>

  </div>
