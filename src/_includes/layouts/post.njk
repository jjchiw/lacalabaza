---
layout: layouts/base.njk
---
{#- A real post file (either language). It hands its data to the shared partial; a post
    with no fediverse toot of its own borrows the other language's toot and replies. -#}
{%- set pair = collections.postPairs | pairOf(pairKey) %}
{%- set sibling = pair["es" if lang == "en" else "en"] if pair else null %}
{%- if fediverse or not sibling %}
{%- set fediverseUrl = fediverse %}{% set replyList = comments %}
{%- else %}
{%- set fediverseUrl = sibling.data.fediverse %}{% set replyList = sibling.data.comments %}
{%- endif %}
{%- set post = {
  url: page.url,
  lang: lang,
  title: title,
  description: description,
  content: content,
  date: page.date,
  tags: tags,
  updated: updated,
  fediverse: fediverseUrl,
  comments: replyList,
  draft: draft,
  source: page.inputPath,
  pair: pair
} %}
{% include "partials/post-page.njk" %}
