<ul class="post-list">
  {%- for group in listPosts | groupByYear %}
  <li class="year">{{ group.year }}</li>
  {%- for post in group.posts %}
  <li class="post"{% if post.data.lang == "es" %} lang="es"{% endif %}>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p>{{ post.data.description }}</p>
    <div class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateFormat(post.data.lang) }}</time><span class="lg">{{ post.data.lang }}</span>{% for tag in post.data.tags %}<span>{{ tag }}</span>{% endfor %}</div>
  </li>
  {%- endfor %}
  {%- endfor %}
</ul>
