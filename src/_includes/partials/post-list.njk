{#- Needs listPairs (collections.postPairs) and lang. One entry per post, in the page's
    language; a post with no file in that language shows the other language's title and
    description with a small mark, and links to this language's URL (the fallback page). -#}
{%- set other = "es" if lang == "en" else "en" %}
<ul class="post-list">
  {%- for group in listPairs | groupByYear %}
  <li class="year">{{ group.year }}</li>
  {%- for pair in group.posts %}
  {%- set urls = pair.key | postUrls %}
  {%- set item = pair[lang] or pair[other] %}
  {%- set shown = lang if pair[lang] else other %}
  <li class="post"{% if shown != lang %} lang="{{ shown }}"{% endif %}>
    <h2><a href="{{ urls[lang] }}">{{ item.data.title }}</a>{% if item.data.draft %} <span class="draft-mark">{{ t[lang].draft }}</span>{% endif %}</h2>
    <p>{{ item.data.description }}</p>
    <div class="meta"><time datetime="{{ pair.date | isoDate }}">{{ pair.date | dateFormat(shown) }}</time>{% if shown != lang %}<span class="lg">{{ shown }}</span>{% endif %}{% for tag in item.data.tags %}<span>{{ tag }}</span>{% endfor %}</div>
  </li>
  {%- endfor %}
  {%- endfor %}
</ul>
