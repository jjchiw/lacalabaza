{#- One post page, real or fallback. Needs post = { url, lang, title, description, content,
    date, tags, updated, fediverse, comments, draft, source, pair }. post.lang is the language of
    the text; lang (the page's) is the language of everything around it. -#}
{%- set T = t[lang] %}
{%- set other = "es" if lang == "en" else "en" %}
{%- set urls = post.pair.key | postUrls %}
{%- set neighbours = collections.postPairs | neighbors(post.pair.key) %}
{%- set toc = post.content | headings %}
  <article lang="{{ post.lang }}">
    <header class="post-head">
      <div class="crumbs" lang="{{ lang }}"><a href="{{ T.root }}#posts">{{ T.writing }}</a><span>›</span><span>{{ post.date.getUTCFullYear() }}</span></div>
      <h1>{{ post.title }}{% if post.draft %} <span class="draft-mark" lang="{{ lang }}">{{ T.draft }}</span>{% endif %}</h1>
      <p class="stand">{{ post.description }}</p>
      <div class="pmeta" lang="{{ lang }}"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateFormat(lang) }}</time><span>{{ post.content | readingTime(lang) }}</span>{% if post.tags %}<span>{% for tag in post.tags %}<span class="tag">{{ tag }}</span> {% endfor %}</span>{% endif %}{% if post.updated %}<span>{{ T.updated }} {{ post.updated | dateFormat(lang) }}</span>{% endif %}</div>
      <nav class="langs tabs" aria-label="{{ T.language }}">
        {%- for l in ["en", "es"] %}
        {%- set name = t.langs[l].name %}
        {%- if loop.index0 %}<span aria-hidden="true">·</span>{% endif %}
        {%- if post.pair[l] %}
        <a href="{{ urls[l] }}" hreflang="{{ l }}" lang="{{ l }}"{% if l == lang %} aria-current="page"{% endif %}>{{ name }}</a>
        {%- else %}
        <span class="soon" lang="{{ l }}"{% if l == lang %} aria-current="page"{% endif %}>{{ name }} ({{ t.langs[l].soon }})</span>
        {%- endif %}
        {%- endfor %}
      </nav>
      {%- if post.lang != lang %}
      <p class="untranslated" lang="{{ lang }}">{{ T.notTranslated }}</p>
      {%- endif %}
    </header>

    <div class="post-grid">
      <div class="prose">
{{ post.content | safe }}
      </div>

      <aside class="rail" lang="{{ lang }}">
        {%- if toc.length %}
        <section class="sec toc">
          <div class="label"><span>{{ T.onThisPage }}</span></div>
          <ol>
            {%- for h in toc %}
            <li><a href="#{{ h.id }}">{{ h.text }}</a></li>
            {%- endfor %}
          </ol>
        </section>
        {%- endif %}
        <section class="sec">
          <div class="label"><span>{{ T.thisPost }}</span></div>
          <ul class="out-list">
            {%- if post.fediverse or site.hollo %}
            <li><span class="k">{{ T.replyLabel }}</span><span class="h"><a href="{{ post.fediverse or site.hollo }}">{{ T.onHollo }}</a></span></li>
            {%- endif %}
            <li><span class="k">{{ T.source }}</span><span class="h"><a href="{{ site.repo }}/blob/main/{{ post.source | replace('./', '') }}">{{ T.editOnGithub }}</a></span></li>
          </ul>
        </section>
      </aside>
    </div>

    {%- if site.hollo or post.fediverse %}
    <section class="sec replies" id="replies" aria-label="{{ T.replies }}" lang="{{ lang }}">
      <div class="label"><span>{{ T.replies }}</span>{% if post.comments.length %}<span>{{ post.comments.length }} {{ T.reply if post.comments.length == 1 else T.repliesMany }}</span>{% endif %}</div>
      <p class="note">{{ T.fediverseNote }} <a href="{{ post.fediverse or site.hollo }}">{{ T.replyOnHollo }}</a></p>
      {%- if post.comments.length %}
      <ul class="reply-list">
        {%- for c in post.comments %}
        <li class="reply">
          <div class="who">
            {%- if c.author.avatar %}<img class="avatar" src="{{ c.author.avatar }}" width="28" height="28" loading="lazy" alt="">{% endif %}
            <span class="name">{% if c.author.url %}<a href="{{ c.author.url }}" rel="nofollow noopener">{{ c.author.name }}</a>{% else %}{{ c.author.name }}{% endif %}</span>
            <span class="acct">@{{ c.author.acct }}</span>
            <a class="when" href="{{ c.url }}" rel="nofollow noopener"><time datetime="{{ c.createdAt }}">{{ c.createdAt | dateFormat(lang) }}</time></a>
          </div>
          <div class="body">{{ c.content | safe }}</div>
        </li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </section>
    {%- endif %}

    <footer class="post-end" lang="{{ lang }}">
      <nav class="pager" aria-label="{{ T.postsAria }}">
        {%- if neighbours.older %}
        {%- set o = neighbours.older %}
        <a href="{{ (o.key | postUrls)[lang] }}" class="prev"><span class="dir">← {{ T.older }}</span><span lang="{{ lang if o[lang] else other }}">{{ (o[lang] or o[other]).data.title }}</span></a>
        {%- endif %}
        {%- if neighbours.newer %}
        {%- set n = neighbours.newer %}
        <a href="{{ (n.key | postUrls)[lang] }}" class="next"><span class="dir">{{ T.newer }} →</span><span lang="{{ lang if n[lang] else other }}">{{ (n[lang] or n[other]).data.title }}</span></a>
        {%- endif %}
      </nav>
    </footer>
  </article>
